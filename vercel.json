{
    "crons": [
        {
            "path": "/api/material-market-sync",
            "schedule": "0 5 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api/).*)",
            "destination": "/"
        }
    ],
    "build": {
        "env": {
            "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
            "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
        }
    }
}
