# BOQ Pro environment variables

# Server-side AI configuration. Never expose these keys in client code.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your_gemini_api_key

# Optional server-side email delivery on Vercel
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=BOQ Pro <onboarding@resend.dev>

# Paystack payment gateway (get your key from https://dashboard.paystack.com/#/settings/developers)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Optional if your Paystack/Vercel API runs on another origin. Leave blank for same-origin /api calls.
VITE_PAYSTACK_API_BASE_URL=

# Optional if you need to allow cross-origin browser requests to `/api` endpoints.
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.example

# Server-side Paystack settings (Vercel / API only — never expose these in src/)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PLAN_CODE_STARTER_MONTHLY=PLN_xxxxxxxxx
PAYSTACK_PLAN_CODE_STARTER_ANNUAL=PLN_xxxxxxxxx
PAYSTACK_PLAN_CODE_PROFESSIONAL_MONTHLY=PLN_xxxxxxxxx
PAYSTACK_PLAN_CODE_PROFESSIONAL_ANNUAL=PLN_xxxxxxxxx
PAYSTACK_PLAN_CODE_BUSINESS_MONTHLY=PLN_xxxxxxxxx
PAYSTACK_PLAN_CODE_BUSINESS_ANNUAL=PLN_xxxxxxxxx
PAYSTACK_PLAN_CODE_CORPORATE_MONTHLY=PLN_xxxxxxxxx
PAYSTACK_PLAN_CODE_CORPORATE_ANNUAL=PLN_xxxxxxxxx

# Firestore service account for secure subscription writes from Vercel API routes
FIREBASE_PROJECT_ID=boq-pro-72332
FIREBASE_SERVICE_ACCOUNT_EMAIL=your-service-account@boq-pro-72332.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
